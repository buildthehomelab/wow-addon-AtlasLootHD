<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
	<Script file="DewDropDown.lua"/>
	<Script file="AtlaslootDefaultFrame.lua"/>

	<!-- The loot browser is built in AtlasLootDefaultFrame_OnLoad -->
	<Frame name="AtlasLootDefaultFrame" toplevel="true" movable="true" enableMouse="true" clampedToScreen="true" hidden="true" parent="UIParent">
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Scripts>
			<OnLoad>
				AtlasLootDefaultFrame_OnLoad(self);
			</OnLoad>
			<OnShow>
				AtlasLootDefaultFrame_OnShow();
			</OnShow>
			<OnHide>
				AtlasLootDefaultFrame_OnHide();
			</OnHide>
			<OnDragStart>
				self:StartMoving();
			</OnDragStart>
			<OnDragStop>
				self:StopMovingOrSizing();
			</OnDragStop>
		</Scripts>
	</Frame>

</Ui>
